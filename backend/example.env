# ==============================
# FastAPI app settings
# ==============================
LOG_LEVEL=INFO
# Separar por comas si usas frontend local y/o producción
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ==============================
# Gemini / Google AI settings
# ==============================
# Coloca tu API key real aquí
GOOGLE_API_KEY=your_google_api_key_here
# Debe ser un modelo válido para tu SDK/configuración
GEMINI_MODEL=gemini-2.5-flash

# ==============================
# OpenAI API Key
# ==============================
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5-nano


# ==============================
# PostgreSQL settings (preferidos)
# ==============================
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres
# Opciones comunes: disable, require
DB_SSLMODE=disable

# ==============================
# CSV paths
# ==============================
# Rutas relativas a la carpeta backend/
ZONAS_WIFI_CSV_PATH=data/zonas-wi-fi-de-cali-2025.csv
CONEXIONES_CSV_PATH=data/conexiones_zonas_wifi_diciembre_2025.csv

# ==============================
# Optional LangSmith tracing
# ==============================
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=wifi-project 

# ==============================
# Alias opcionales de DB (solo si los necesitas)
# El proyecto también acepta estas llaves como fallback:
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# DBNAME=wifi_project
# HOST=localhost
# PORT=5432
# PASSWORD=postgres
